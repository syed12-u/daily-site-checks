# Copy to .env and fill in. Never commit .env.

# --- Teams -----------------------------------------------------------------
# Incoming webhook URL (Workflows connector or classic incoming webhook).
TEAMS_WEBHOOK_URL=
# Optional: comma-separated UPNs (emails) to @mention on Critical alerts.
TEAMS_MENTION_UPNS=
# Optional: display names matching the UPNs above, same order.
TEAMS_MENTION_NAMES=

# --- Reports ---------------------------------------------------------------
# Where the run folder is copied after each run (network share, OneDrive folder,
# or an Azure Blob container mounted/synced locally). Leave empty to skip.
PUBLISH_DIR=
# Public base URL that maps to PUBLISH_DIR, used for links and diff images in
# Teams cards, e.g. https://<account>.blob.core.windows.net/site-sentinel
REPORT_BASE_URL=

# --- Behaviour -------------------------------------------------------------
# Retries per failed test before alerting (plan: 2, 60 s apart).
RETRIES=2
RETRY_DELAY_SECONDS=60
# Days of run history to keep in runs/
HISTORY_DAYS=30
# Limit run to some sites: comma-separated keys (perhaps,flexoffers,fusetwo,incubators)
SITES=
# Set to true once every site has a safe way to receive a test submission
# (hidden test field or tagged email). Until then FN-04 / UF-01 stop before submit.
ENABLE_FORM_SUBMIT=false
# Email used for test submissions; must be recognised by the sites as a test.
TEST_EMAIL=sentinel-test@flexoffers.com
# Ask Claude Code for a short narrative of failures in the daily card (needs `claude` on PATH).
ANALYZE_WITH_CLAUDE=false
